[Unit]
Description=OpenIBAN Dutch BIC snapshot update
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=openiban
Group=openiban
Environment=OPENIBAN_DATABASE_URL=sqlite:////var/lib/openiban/openiban.db
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/openiban.eu/.venv/bin/openiban update-nl
TimeoutStartSec=180
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openiban
